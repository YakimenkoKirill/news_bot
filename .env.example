# Окружение: dev или prod (выбирает configs/{ENV}.yaml поверх configs/base.yaml)
ENV=dev

# PostgreSQL для разработки (docker/docker-compose.dev.yml, make db-up).
# Пароль замените на свой и поправьте его в DATABASE_URL и TEST_DATABASE_URL.
POSTGRES_USER=news
POSTGRES_PASSWORD=change_me
POSTGRES_DB=news
# Отдельная БД для интеграционных тестов, её создаёт make db-up
POSTGRES_TEST_DB=news_test
POSTGRES_PORT=5432
# На сервере (docker/docker-compose.prod.yml) хост БД — postgres:5432
DATABASE_URL=postgresql+asyncpg://news:change_me@localhost:5432/news
TEST_DATABASE_URL=postgresql+asyncpg://news:change_me@localhost:5432/news_test

# Бот управления и канал (токен — у @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Telegram ID админов бота через запятую: 111111111,222222222
TELEGRAM_ADMIN_IDS=

# Telethon (my.telegram.org)
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION_PATH=data/telethon

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

LOG_LEVEL=INFO

# Любой ключ yaml можно переопределить через двойное подчёркивание, например:
# APP__TIMEZONE=Europe/Moscow
