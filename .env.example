# Окружение: dev или prod (выбирает configs/{ENV}.yaml поверх configs/base.yaml)
ENV=dev

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://news:news@localhost:5432/news

# Бот управления и канал (токен — у @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Telegram ID админов бота через запятую: 111111111,222222222
TELEGRAM_ADMIN_IDS=

# Telethon (my.telegram.org)
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION_PATH=data/telethon

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

LOG_LEVEL=INFO

# Любой ключ yaml можно переопределить через двойное подчёркивание, например:
# APP__TIMEZONE=Europe/Moscow
